generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model CartItem {
  id        String   @id @default(uuid())
  productId String
  quantity  Int
  userId    String

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])


  @@index([productId])
  @@index([userId])

  variantId String
}

model Order {
  id String @id @default(uuid())

  userId String

  paymentType String

  shippingCost Int

  totalAmount Int

  status String @default("PENDING")

  fullName String
  phone String

  address1 String
  address2 String?

  city String
  state String

  pincode String

  createdAt DateTime @default(now())

 user User @relation(fields: [userId], references: [id])

  orderItems OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  variantId String
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?

  stock       Int?
  image       String?
  thumbnail   String?

  productType String @default("weight")

  variants ProductVariant[]

  orderItems OrderItem[]
  cartItems  CartItem[]
}

model ProductVariant {
  id        String @id @default(uuid())

  label     String
  price     Int

  productId String
  product   Product @relation(fields:[productId], references:[id])
  
  stock Int @default(0)


  @@index([productId])
}


model User {
  id String @id @default(uuid())

  name String?

  email String @unique

  password String

  orders Order[]

  cartItems CartItem[]

  addresses Address[]
}

model Address {
  id String @id @default(uuid())

  userId String

  fullName String
  phone String

  address1 String
  address2 String?

  city String
  state String
  pincode String

  saveAddress Boolean @default(false)

  user User @relation(fields:[userId], references:[id])

  createdAt DateTime @default(now())
}